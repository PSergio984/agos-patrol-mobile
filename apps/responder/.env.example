# Copy to .env (gitignored). Pick ONE block and uncomment it.

# --- Physical phone on same Wi-Fi (Expo Go or dev build) ---
# Replace with this PC's LAN IP (run `ipconfig` -> IPv4 Address).
# `localhost` will NOT work — localhost on the phone is the phone itself.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8000
# EXPO_PUBLIC_WS_URL=ws://192.168.1.50:8000

# --- Android emulator (agos-backend running on this PC) ---
# 10.0.2.2 is the emulator's alias for host localhost.
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
# EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8000

# --- iOS simulator / local dev on this machine ---
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# EXPO_PUBLIC_WS_URL=ws://localhost:8000

# --- Deployed backend (what the PWA uses — copy from the
#     agos-patrol Vercel project's VITE_API_BASE_URL env) ---
# EXPO_PUBLIC_API_BASE_URL=https://your-backend.example.com
# EXPO_PUBLIC_WS_URL=wss://your-backend.example.com

# Notes:
# - API client appends /api/v1 automatically — set the host root only.
# - WS client appends /ws?location_id=<id> — set the host root only.
# - ws:// for http backends, wss:// for https.
# - Firewall: allow Python/uvicorn on Private networks or port 8000
#   won't be reachable from the phone.
# - Restart `npx expo start -c` after editing (env is bundled at start).
